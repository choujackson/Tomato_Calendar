# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=tomato_calendar_db

# JWT 密钥 (生产环境请使用复杂的随机字符串)
JWT_SECRET=super-secret-key-change-this
JWT_EXPIRES_IN=7d

# 邮件服务配置 (SMTP)
# ⚠️ 重要：QQ邮箱必须使用授权码，不是登录密码！

# QQ邮箱配置示例
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=your_email@qq.com
MAIL_PASSWORD=your_auth_code_here
# MAIL_FROM 可选：如果不设置，会自动使用 MAIL_USER 作为发件人
# ⚠️ 重要：如果设置了 MAIL_FROM，其中的邮箱地址必须与 MAIL_USER 完全一致！
MAIL_FROM="Tomato Calendar" <your_email@qq.com>

# 其他邮箱配置示例（取消注释并修改）：
# Gmail:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_FROM="Tomato Calendar" <your_email@gmail.com>

# 163邮箱:
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USER=your_email@163.com
# MAIL_PASSWORD=your_auth_code
# MAIL_FROM="Tomato Calendar" <your_email@163.com>

